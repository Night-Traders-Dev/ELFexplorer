# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc.*

# Python tooling caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and temporary files
*.log
tmp/
temp/
.cache/

# Common native build outputs
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.elf

# Keep ELF fixture corpus under version control
!test-bin/
!test-bin/**
